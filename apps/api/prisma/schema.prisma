generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  RECORDS
  ACCOUNTS
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BillStatus {
  PENDING
  PAID
  VOIDED
}

enum PrescriptionStatus {
  PENDING
  READY
  DISPENSED
  CANCELLED
}

enum LabOrderStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String

  firstName    String
  lastName     String
  role         UserRole
  mdcSerial    String?
  specialty    String?

  isActive     Boolean   @default(true)
  lastLogin    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointments    Appointment[] @relation("AppointmentDoctor")
  consultations   Consultation[]
}

model Patient {
  id              String    @id @default(uuid())

  hospitalId      String    @unique
  nationalId      String?   @unique
  nhisNumber      String?   @unique

  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime
  gender          Gender
  phone           String?
  email           String?
  address         String?
  state           String?
  lga             String?
  occupation      String?
  religion        String?
  bloodGroup      String?
  genotype        String?

  allergies       Json?
  chronicConditions Json?

  nextOfKinName      String?
  nextOfKinPhone     String?
  nextOfKinRelation  String?

  photo           String?

  isDeceased      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments    Appointment[]
  consultations   Consultation[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  bills           Bill[]
}

model Appointment {
  id              String          @id @default(uuid())
  patientId       String
  doctorId        String?

  appointmentDate DateTime
  department      String
  type            String
  status          AppointmentStatus @default(SCHEDULED)

  notes           String?
  checkedInAt     DateTime?
  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime  @updatedAt

  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          User?    @relation("AppointmentDoctor", fields: [doctorId], references: [id])
}

model Consultation {
  id                      String   @id @default(uuid())
  patientId               String
  doctorId                String

  visitType               String
  chiefComplaint          String
  historyOfPresentIllness String?
  physicalExamination     String?

  diagnosis               Json
  treatmentPlan           String?

  vitals                  Json?

  consultationDate        DateTime @default(now())

  prescriptions           Prescription[]
  labOrders               LabOrder[]

  patient                 Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                  User     @relation(fields: [doctorId], references: [id])
}

model Prescription {
  id                String    @id @default(uuid())
  patientId         String
  consultationId    String?
  consultation      Consultation? @relation(fields: [consultationId], references: [id])

  items             Json
  status            PrescriptionStatus @default(PENDING)

  prescribedAt      DateTime @default(now())
  dispensedAt       DateTime?
  dispensedBy       String?

  patient           Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id                String    @id @default(uuid())
  patientId         String
  consultationId    String?
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  testType          String
  testCode          String?

  status            LabOrderStatus @default(PENDING)
  sampleCollectedAt DateTime?
  resultEnteredAt   DateTime?

  result            Json?
  reportUrl         String?
  verifiedBy        String?
  verifiedAt        DateTime?

  createdAt         DateTime @default(now())

  patient           Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Bill {
  id                String    @id @default(uuid())
  patientId         String
  consultationId    String?

  billNumber        String    @unique
  items             Json

  subtotal          Decimal   @db.Decimal(10, 2)
  discount          Decimal   @default(0) @db.Decimal(10, 2)
  total             Decimal   @db.Decimal(10, 2)

  paymentMethod     String?
  paidAt            DateTime?
  paidBy            String?
  status            BillStatus @default(PENDING)

  createdAt         DateTime @default(now())
  updatedAt         DateTime  @updatedAt

  patient           Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
